#!/usr/bin/env bash
# Fast governance gate: the checks that must never be committed broken.
#
# Deliberately excludes tests/property, which rebuilds the staging layer twice
# and takes well over a minute. Those run in CI and on demand. A hook slow
# enough to be bypassed is a hook that gets bypassed.
#
# Install once:  git config core.hooksPath .githooks

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

PYTHON="${TW_ALPHA_PYTHON:-C:/project/tw-sepa-screener/.venv/Scripts/python.exe}"
if [ ! -x "$PYTHON" ]; then
  PYTHON="$(command -v python3 || command -v python || true)"
fi
if [ -z "$PYTHON" ]; then
  echo "pre-commit: no python interpreter found; set TW_ALPHA_PYTHON" >&2
  exit 1
fi

echo "pre-commit: M0 prohibitions, retry policy, M4 rules and M5 ledger"
PYTHONPATH="$REPO_ROOT" PYTHONIOENCODING=utf-8 \
  "$PYTHON" -m pytest tests/unit tests/invariant m4/tests m5/tests -q --no-header

# Licensed vendor exports must not be committed or redistributed. This
# checked only .zip while TEJ's company master arrives as .xlsx and its bulk
# exports as UTF-16 .csv, so the rule matched the one shape nobody had sent.
# The .gitignore carried the same gap. Checked on every staged file, not only
# added ones: a file can be ignored today and staged deliberately tomorrow.
echo "pre-commit: refusing licensed vendor exports"
if git diff --cached --name-only | grep -qiE '\.(zip|xlsx|xls)$'; then
  echo "pre-commit: a vendor export (.zip/.xlsx/.xls) is staged." >&2
  echo "pre-commit: licensed data belongs in the raw_v2 lane, not in git." >&2
  exit 1
fi



# Private evidence must never be staged. Same reasoning as the vendor exports
# above, different reason for privacy: the broker archive is a personal
# financial profile (which broker, when the account was opened), and a
# .gitignore is one `git add -f` away from not mattering.
echo "pre-commit: refusing private evidence"
if git diff --cached --name-only | grep -qE '^private/'; then
  echo "pre-commit: a file under private/ is staged." >&2
  echo "pre-commit: its hash is published in docs/evidence/; the bytes are not." >&2
  exit 1
fi

echo "pre-commit: ok"
